<PISI>
    <Source>
        <Name>filmcraft</Name>
        <Packager>
            <Name>Maxim Sorkin</Name>
            <Email>msork.uni2004@gmail.com</Email>
        </Packager>
        <Summary>Open-source, native video editor: edit video, color and sound.</Summary>
        <Description>Timeline editing with source and program monitors, color grading and scopes, effects and keyframes, titles and captions, audio mixing with loudness meters, and export; GPU compositing (wgpu). Includes filmcraft-cli, a headless command runner, MCP server and exporter.</Description>
        <License>Apache-2.0 / MIT</License>
        <Archive sha1sum="a740df68b91bf1fa3f7c2db135379959913769bd" type="binary">https://github.com/storytold/filmcraft/releases/download/v0.5.0/filmcraft-0.5.0-linux-x86_64.deb</Archive>

        <BuildDependencies>
            <Dependency>binutils</Dependency>
        </BuildDependencies>
    </Source>

    <Package>
        <Name>filmcraft</Name>
        <Files>
